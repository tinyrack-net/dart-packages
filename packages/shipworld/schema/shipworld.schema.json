{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tinyrack-net/dart-packages/raw/main/packages/shipworld/schema/shipworld.schema.json",
  "title": "Shipworld configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "remote", "batch-commit", "targets"],
  "properties": {
    "schema": { "const": 1 },
    "remote": { "$ref": "#/$defs/nonEmptyString" },
    "batch-commit": {
      "type": "string",
      "pattern": "\\{targets\\}"
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^(?:[A-Za-z]:)?[/\\\\]" },
          { "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)" }
        ]
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "$ref": "#/$defs/relativePath" },
        "synchronized": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path"],
            "properties": {
              "type": { "const": "dart-constant" },
              "path": { "$ref": "#/$defs/relativePath" },
              "constant": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "display-name", "description", "executable"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "display-name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "executable": { "$ref": "#/$defs/nonEmptyString" },
        "homepage": { "type": "string", "format": "uri" },
        "repository": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "launcher"],
      "properties": {
        "kind": { "enum": ["executable", "directory"] },
        "launcher": { "$ref": "#/$defs/relativePath" }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application-id", "executable", "identity"],
      "properties": {
        "application-id": { "$ref": "#/$defs/nonEmptyString" },
        "executable": { "$ref": "#/$defs/relativePath" },
        "background-color": { "$ref": "#/$defs/nonEmptyString" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name-env",
            "publisher-env",
            "publisher-display-name-env"
          ],
          "properties": {
            "name-env": { "$ref": "#/$defs/nonEmptyString" },
            "publisher-env": { "$ref": "#/$defs/nonEmptyString" },
            "publisher-display-name-env": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "display-name-env": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "macos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entitlements": { "$ref": "#/$defs/relativePath" },
        "bundle-name": { "$ref": "#/$defs/nonEmptyString" },
        "bundle-id": { "$ref": "#/$defs/nonEmptyString" },
        "minimum-version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "linuxIcon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "path"],
      "properties": {
        "size": { "type": "integer", "minimum": 0 },
        "path": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "linuxDeb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depends": { "$ref": "#/$defs/stringArray" },
        "recommends": { "$ref": "#/$defs/stringArray" },
        "conflicts": { "$ref": "#/$defs/stringArray" },
        "section": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "linuxRpm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": { "$ref": "#/$defs/stringArray" },
        "recommends": { "$ref": "#/$defs/stringArray" },
        "conflicts": { "$ref": "#/$defs/stringArray" },
        "release": { "$ref": "#/$defs/nonEmptyString" },
        "group": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "linux": {
      "type": "object",
      "additionalProperties": false,
      "required": ["icon", "categories", "terminal"],
      "properties": {
        "icon": { "$ref": "#/$defs/nonEmptyString" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "terminal": { "type": "boolean" },
        "maintainer": { "$ref": "#/$defs/nonEmptyString" },
        "license": { "$ref": "#/$defs/nonEmptyString" },
        "vendor": { "$ref": "#/$defs/nonEmptyString" },
        "app-id": { "$ref": "#/$defs/nonEmptyString" },
        "prefix": { "$ref": "#/$defs/nonEmptyString" },
        "launcher-style": { "enum": ["symlink", "wrapper"] },
        "icons": {
          "type": "array",
          "items": { "$ref": "#/$defs/linuxIcon" }
        },
        "deb": { "$ref": "#/$defs/linuxDeb" },
        "rpm": { "$ref": "#/$defs/linuxRpm" }
      }
    },
    "homebrew": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula-class", "artifact-prefix"],
      "properties": {
        "formula-class": { "$ref": "#/$defs/nonEmptyString" },
        "artifact-prefix": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "root",
        "version",
        "tag",
        "commit",
        "branch"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pub-package",
            "cli-application",
            "flutter-application"
          ]
        },
        "root": { "$ref": "#/$defs/relativePath" },
        "version": { "$ref": "#/$defs/version" },
        "changelog": { "$ref": "#/$defs/relativePath" },
        "tag": {
          "type": "string",
          "pattern": "\\{version\\}"
        },
        "commit": { "$ref": "#/$defs/nonEmptyString" },
        "branch": { "$ref": "#/$defs/nonEmptyString" },
        "product": { "$ref": "#/$defs/product" },
        "payload": { "$ref": "#/$defs/payload" },
        "windows": { "$ref": "#/$defs/windows" },
        "macos": { "$ref": "#/$defs/macos" },
        "linux": { "$ref": "#/$defs/linux" },
        "homebrew": { "$ref": "#/$defs/homebrew" }
      }
    }
  }
}
